# Copy to .env. Never commit secrets.
GEMINI_API_KEY=your-gemini-key-here
DATABASE_URL=sqlite:///./helios.db
# DATABASE_URL=postgresql+psycopg://helios:helios@localhost:5432/helios

GEMINI_AUDIT_MODEL=gemini-2.5-pro
GEMINI_FIX_MODEL=gemini-2.5-pro
GEMINI_ROUTE_MODEL=gemini-2.5-flash

SANDBOX_TIMEOUT_S=5
SANDBOX_MEM_MB=512
TEST_CASE_COUNT=12

# Live audit
GEMINI_LIVE_MODEL=gemini-2.5-flash
LIVE_MAX_FILE_LINES=1500
LIVE_RATE_CAPACITY=30
LIVE_RATE_REFILL_PER_S=1.0
LIVE_CACHE_MAX_TOKENS=256
LIVE_CACHE_TTL_S=1800
